## The zone's list of people and their latest pose packets. A person is three entities: head and
## two hands, with gid = PLAYER_ENTITY_BASE + person * PARTS + part, as the client numbers them.

const PACKET_BYTES: int = 100
const PLAYER_ENTITY_BASE: int = 2000000
const PARTS: int = 3
const MAX_PEOPLE: int = 4

const OK: int = 0
const REFUSED_SIZE: int = 1
const REFUSED_ENTITY: int = 2
const REFUSED_STRANGER: int = 3

var people: Array = []
var latest: Dictionary = {}


func join(person: int) -> bool:
	if people.has(person):
		return true
	if people.size() >= MAX_PEOPLE:
		return false
	people.append(person)
	latest[person] = [PackedByteArray(), PackedByteArray(), PackedByteArray()]
	return true


func leave(person: int) -> bool:
	if not people.has(person):
		return false
	people.erase(person)
	latest.erase(person)
	return true


func count() -> int:
	return people.size()


func ingest(pkt: PackedByteArray) -> int:
	if pkt.size() != PACKET_BYTES:
		return REFUSED_SIZE
	var gid: int = pkt.decode_u32(0)
	if gid < PLAYER_ENTITY_BASE:
		return REFUSED_ENTITY
	var offset: int = gid - PLAYER_ENTITY_BASE
	var person: int = offset / PARTS
	var part: int = offset % PARTS
	if not people.has(person):
		return REFUSED_STRANGER
	var parts: Array = latest[person]
	parts[part] = pkt
	return OK


func view(person: int) -> Array:
	var out: Array = []
	for other in people:
		if other == person:
			continue
		var parts: Array = latest[other]
		for pkt in parts:
			if pkt.size() == PACKET_BYTES:
				out.append(pkt)
	return out

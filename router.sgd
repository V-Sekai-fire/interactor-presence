## The zone as a router. It holds four slots and hands each slot the latest two frames of the
## other three, as they came. It reads no byte of a frame: what a frame says is for the viewers.
## Its pass runs at every tick of 64 per second. A slot sends once every SEND_TICKS ticks.

const SLOTS: int = 4
const FRAME_BYTES: int = 1200
const SILENT_TICKS: int = 192
const SEND_TICKS: int = 6

var people: Array = [-1, -1, -1, -1]
var frames: Array = []
var taken: Array = []
var heard: Array = [0, 0, 0, 0]
var unread: int = 0
var now: int = 0


func _blank() -> PackedByteArray:
	var blank: PackedByteArray = PackedByteArray()
	blank.resize(FRAME_BYTES)
	return blank


func reset() -> bool:
	frames = []
	taken = []
	for i in SLOTS * 2:
		frames.append(_blank())
		taken.append(false)
	people = [-1, -1, -1, -1]
	heard = [0, 0, 0, 0]
	unread = 0
	now = 0
	return true


## The slot the person holds, or -1 when the zone is full.
func join(person: int) -> int:
	for s in SLOTS:
		if people[s] == person:
			return s
	for s in SLOTS:
		if people[s] == -1:
			people[s] = person
			heard[s] = now
			return s
	return -1


func leave(person: int) -> bool:
	for s in SLOTS:
		if people[s] == person:
			people[s] = -1
			frames[s * 2] = _blank()
			frames[s * 2 + 1] = _blank()
			return true
	return false


func person_at(slot: int) -> int:
	return people[slot]


## One frame of one half from a slot. Only the first of a half in a send interval is taken; the
## rest are counted and not read.
func put(slot: int, half: int, frame: PackedByteArray) -> bool:
	if slot < 0 or slot >= SLOTS or half < 0 or half > 1:
		return false
	if people[slot] == -1:
		return false
	var at: int = slot * 2 + half
	if taken[at]:
		unread += 1
		return false
	taken[at] = true
	frames[at] = frame
	heard[slot] = now
	return true


## Frame k of 6 for a viewer: the two halves of each other slot, in slot order. An empty slot
## gives the blank frame.
func frame(viewer: int, k: int) -> PackedByteArray:
	var other: int = k / 2
	var half: int = k % 2
	var slot: int = other
	if other >= viewer:
		slot = other + 1
	return frames[slot * 2 + half]


## The same pass whoever is present: every slot is visited, and a slot silent for 3 s is emptied.
func tick() -> int:
	now += 1
	var opens: bool = now % SEND_TICKS == 0
	for s in SLOTS:
		if opens:
			taken[s * 2] = false
			taken[s * 2 + 1] = false
		if people[s] != -1 and now - heard[s] > SILENT_TICKS:
			people[s] = -1
			frames[s * 2] = _blank()
			frames[s * 2 + 1] = _blank()
	return now


func unread_count() -> int:
	return unread
